msgid_plural "%s (%d windows)"
msgstr[0] "%s (%d ventana)"
msgstr[1] "%s (%d ventanas)"

#: extension/stage-manager@wyliam/lib/strip.js:120
msgid "Bring to the stage"
msgstr "Traer al escenario"

#: extension/stage-manager@wyliam/lib/strip.js:122
msgid "Add to the stage group"
msgstr "Añadir al grupo del escenario"

#: extension/stage-manager@wyliam/lib/strip.js:125
msgid "Bring only one window"
msgstr "Traer solo una ventana"

#: extension/stage-manager@wyliam/lib/strip.js:127
msgid "Untitled"
msgstr "Sin título"

#: extension/stage-manager@wyliam/lib/strip.js:129
msgid "Split the windows in the strip"
msgstr "Separar las ventanas en la barra lateral"

#: extension/stage-manager@wyliam/lib/strip.js:134
msgid "New window"
msgstr "Nueva ventana"

#: extension/stage-manager@wyliam/lib/strip.js:135
msgid "Close all windows"
msgstr "Cerrar todas las ventanas"

#: extension/stage-manager@wyliam/lib/strip.js:135
msgid "Close window"
msgstr "Cerrar ventana"

#: extension/stage-manager@wyliam/lib/strip.js:137
msgid "Quit app"
msgstr "Salir de la aplicación"

#: extension/stage-manager@wyliam/lib/strip.js:144
msgid "Move to monitor"
msgstr "Mover al monitor"

#: extension/stage-manager@wyliam/lib/strip.js:147
#, python-format
msgid "Monitor %d"
msgstr "Monitor %d"

#: extension/stage-manager@wyliam/lib/strip.js:152
msgid "Move to workspace"
msgstr "Mover al espacio de trabajo"

#: extension/stage-manager@wyliam/lib/strip.js:156
#, python-format
msgid "Workspace %d"
msgstr "Espacio de trabajo %d"

#: extension/stage-manager@wyliam/lib/strip.js:163
msgid "Autotiling for groups"
msgstr "Autotiling para los grupos"

#: extension/stage-manager@wyliam/lib/strip.js:167
msgid "Rearrange the stage group"
msgstr "Reorganizar el grupo del escenario"

#: extension/stage-manager@wyliam/lib/strip.js:168
msgid "Back to the stage"
msgstr "Volver al escenario"

#: extension/stage-manager@wyliam/lib/strip.js:168 extension/stage-manager@wyliam/prefs.js:17
msgid "Show the desktop"
msgstr "Mostrar el escritorio"

#: extension/stage-manager@wyliam/lib/strip.js:170
msgid "Ignore this app (do not manage)"
msgstr "Ignorar esta aplicación (no gestionar)"

#: extension/stage-manager@wyliam/lib/strip.js:171
msgid "Preferences…"
msgstr "Preferencias…"

#: extension/stage-manager@wyliam/prefs.js:9
msgid "Turn Stage Manager on/off"
msgstr "Activar/desactivar Organizador visual"

#: extension/stage-manager@wyliam/prefs.js:10
msgid "Turn group autotiling on/off"
msgstr "Activar/desactivar el autotiling de los grupos"

#: extension/stage-manager@wyliam/prefs.js:11
msgid "Ignore / manage again the focused window's app"
msgstr "Ignorar / volver a gestionar la aplicación de la ventana con foco"

#: extension/stage-manager@wyliam/prefs.js:12
msgid "Pick a window to ignore with the mouse"
msgstr "Elegir con el ratón una ventana que ignorar"

#: extension/stage-manager@wyliam/prefs.js:13
msgid "Switch to the most recent set in the strip"
msgstr "Cambiar al conjunto más reciente de la barra lateral"

#: extension/stage-manager@wyliam/prefs.js:14
msgid "Add the most recent set to the stage"
msgstr "Añadir al escenario el conjunto más reciente"

#: extension/stage-manager@wyliam/prefs.js:15
msgid "Remove the focused window from the group"
msgstr "Quitar del grupo la ventana con foco"

#: extension/stage-manager@wyliam/prefs.js:16
msgid "Rearrange the group as a mosaic"
msgstr "Reorganizar el grupo en mosaico"

#: extension/stage-manager@wyliam/prefs.js:51
msgid "General"
msgstr "General"

#: extension/stage-manager@wyliam/prefs.js:53
msgid "Stage Manager on"
msgstr "Organizador visual activado"

#: extension/stage-manager@wyliam/prefs.js:54
msgid "Show recent apps"
msgstr "Mostrar aplicaciones recientes"

#: extension/stage-manager@wyliam/prefs.js:54
msgid "When off, the strip only appears when the pointer touches the screen edge."
msgstr "Si está desactivado, la barra lateral solo aparece cuando el puntero toca el borde de la pantalla."

#: extension/stage-manager@wyliam/prefs.js:55
msgid "Windows of an app"
msgstr "Ventanas de una aplicación"

#: extension/stage-manager@wyliam/prefs.js:56
msgid ""
"One at a time: each new window gets its own stage. All at once: windows of the same app go to the"
" same stage."
msgstr ""
"Una a la vez: cada ventana nueva tiene su propio escenario. Todas juntas: las ventanas de la "
"misma aplicación van al mismo escenario."

#: extension/stage-manager@wyliam/prefs.js:57
msgid "One at a time"
msgstr "Una a la vez"

#: extension/stage-manager@wyliam/prefs.js:57
msgid "All at once"
msgstr "Todas juntas"

#: extension/stage-manager@wyliam/prefs.js:58
msgid "Center when entering the stage"
msgstr "Centrar al entrar en el escenario"

#: extension/stage-manager@wyliam/prefs.js:58
msgid "Super+Alt+R centers the window (or rearranges the group) whenever you want."
msgstr "Super+Alt+R centra la ventana (o reorganiza el grupo) cuando quieras."

#: extension/stage-manager@wyliam/prefs.js:59
msgid "Always keep centered (outside autotiling)"
msgstr "Mantener siempre centrada (fuera del autotiling)"

#: extension/stage-manager@wyliam/prefs.js:59
msgid ""
"The window returns to the center as soon as you drop it or finish resizing it. Overrides "
"“remember position”."
msgstr ""
"La ventana vuelve al centro en cuanto la sueltas o terminas de redimensionarla. Ignora «recordar "
"la posición»."

#: extension/stage-manager@wyliam/prefs.js:60
msgid "Resize from the center"
msgstr "Redimensionar desde el centro"

#: extension/stage-manager@wyliam/prefs.js:61
msgid "The window grows or shrinks on both sides at once, keeping its center. Not used with autotiling."
msgstr ""
"La ventana crece o se encoge por ambos lados a la vez, manteniendo su centro. No se aplica con el"
" autotiling."

#: extension/stage-manager@wyliam/prefs.js:62
msgid "Off"
msgstr "Desactivado"

#: extension/stage-manager@wyliam/prefs.js:62
msgid "While holding Alt"
msgstr "Mientras se mantiene Alt"

#: extension/stage-manager@wyliam/prefs.js:62
msgid "Always (Alt gives the regular resize)"
msgstr "Siempre (Alt da el redimensionado normal)"

#: extension/stage-manager@wyliam/prefs.js:63
msgid "Remember the position of windows moved by hand"
msgstr "Recordar la posición de las ventanas movidas a mano"

#: extension/stage-manager@wyliam/prefs.js:63
msgid "When off, the window always returns to the center when entering the stage."
msgstr "Si está desactivado, la ventana siempre vuelve al centro al entrar en el escenario."

#: extension/stage-manager@wyliam/prefs.js:64
msgid "Re-center after resizing"
msgstr "Volver a centrar tras redimensionar"

#: extension/stage-manager@wyliam/prefs.js:65
msgid "Clicking the wallpaper shows the desktop"
msgstr "Hacer clic en el fondo de escritorio muestra el escritorio"

#: extension/stage-manager@wyliam/prefs.js:66
msgid "Windows go to the strip; click again to bring them back."
msgstr "Las ventanas pasan a la barra lateral; otro clic las devuelve."

#: extension/stage-manager@wyliam/prefs.js:69
msgid "Window groups"
msgstr "Grupos de ventanas"

#: extension/stage-manager@wyliam/prefs.js:70
msgid ""
"Drag a thumbnail from the strip onto the stage, or use Shift+click, or the + button on the "
"thumbnail. To remove a window, drag it onto the strip."
msgstr ""
"Arrastra una miniatura de la barra lateral al escenario, o usa Mayús+clic, o el botón + de la "
"miniatura. Para quitar una ventana, arrástrala a la barra lateral."

#: extension/stage-manager@wyliam/prefs.js:73
msgid "Autotiling (like Pop Shell)"
msgstr "Autotiling (como Pop Shell)"

#: extension/stage-manager@wyliam/prefs.js:74
msgid ""
"Windows on the stage fill the whole screen in a tree layout, leaving the app strip on the left. "
"Resizing moves the divider; dropping a window onto another swaps them. Replaces the mosaic."
msgstr ""
"Las ventanas del escenario llenan toda la pantalla en forma de árbol, dejando la barra de "
"aplicaciones a la izquierda. Redimensionar mueve el divisor; soltar una ventana sobre otra las "
"intercambia. Sustituye al mosaico."

#: extension/stage-manager@wyliam/prefs.js:75
msgid "Strip always visible with autotiling"
msgstr "Barra lateral siempre visible con autotiling"

#: extension/stage-manager@wyliam/prefs.js:76
msgid ""
"When off, the strip hides (it appears when the pointer touches the edge) and windows use the "
"whole screen."
msgstr ""
"Si está desactivado, la barra lateral se oculta (aparece al tocar el borde) y las ventanas usan "
"toda la pantalla."

#: extension/stage-manager@wyliam/prefs.js:77
msgid "Autotiling margin (px)"
msgstr "Margen del autotiling (px)"

#: extension/stage-manager@wyliam/prefs.js:77
msgid "Distance between windows and the screen edge (and the strip)."
msgstr "Distancia entre las ventanas y el borde de la pantalla (y de la barra lateral)."

#: extension/stage-manager@wyliam/prefs.js:78
msgid "Autotiling gap between windows (px)"
msgstr "Separación entre ventanas en el autotiling (px)"

#: extension/stage-manager@wyliam/prefs.js:79
msgid "Group layout"
msgstr "Disposición del grupo"

#: extension/stage-manager@wyliam/prefs.js:80
msgid ""
"Mosaic: rearranges when a window joins or leaves, is resized, or is dropped onto another. Free: "
"only arranges when the composition of the group changes."
msgstr ""
"Mosaico: se reorganiza cuando entra o sale una ventana, al redimensionar y al soltar una ventana "
"sobre otra. Libre: solo organiza cuando cambia la composición del grupo."

#. TRANSLATORS: layout mode where the user arranges windows freely (no automatic rearranging)
#: extension/stage-manager@wyliam/prefs.js:82
msgid "Mosaic"
msgstr "Mosaico"

#: extension/stage-manager@wyliam/prefs.js:82
msgid "Free"
msgstr "Libre"

#: extension/stage-manager@wyliam/prefs.js:85
msgid "Picture-in-Picture"
msgstr "Imagen en imagen"

#: extension/stage-manager@wyliam/prefs.js:86
msgid ""
"Picture-in-Picture from Firefox and Chrome stays in the stage group where it appears (and goes "
"away with it). Only its width takes part in tiling; the height follows the video aspect ratio. "
"Drag the PiP to another corner to move it."
msgstr ""
"La imagen en imagen de Firefox y Chrome se queda en el grupo del escenario donde aparece (y "
"desaparece con él). Solo su anchura participa en el tiling; la altura sigue la proporción del "
"vídeo. Arrastra la ventana a otra esquina para moverla."

#: extension/stage-manager@wyliam/prefs.js:89
msgid "Treat Picture-in-Picture as an exception"
msgstr "Tratar la imagen en imagen como excepción"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "PiP corner"
msgstr "Esquina de la imagen en imagen"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "Bottom right"
msgstr "Abajo a la derecha"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "Bottom left"
msgstr "Abajo a la izquierda"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "Top right"
msgstr "Arriba a la derecha"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "Top left"
msgstr "Arriba a la izquierda"

#: extension/stage-manager@wyliam/prefs.js:91
#, python-format
msgid "Maximum PiP width (% of the area)"
msgstr "Anchura máxima de la imagen en imagen (% del área)"

#: extension/stage-manager@wyliam/prefs.js:92
msgid "PiP title patterns (comma-separated)"
msgstr "Patrones del título de la imagen en imagen (separados por comas)"

#. TRANSLATORS: the side column of app thumbnails (recent apps)
#: extension/stage-manager@wyliam/prefs.js:98
msgid "Strip"
msgstr "Barra lateral"

#: extension/stage-manager@wyliam/prefs.js:101
msgid "Strip side"
msgstr "Lado de la barra lateral"

#: extension/stage-manager@wyliam/prefs.js:101
msgid "Left"
msgstr "Izquierda"

#: extension/stage-manager@wyliam/prefs.js:101
msgid "Right"
msgstr "Derecha"

#: extension/stage-manager@wyliam/prefs.js:102
msgid "Show the + button on thumbnails"
msgstr "Mostrar el botón + en las miniaturas"

#: extension/stage-manager@wyliam/prefs.js:102
msgid "Adds the set to the stage group. Shift+click and dragging also work."
msgstr "Añade el conjunto al grupo del escenario. Mayús+clic y arrastrar también funcionan."

#: extension/stage-manager@wyliam/prefs.js:103
msgid "Thumbnail width (px)"
msgstr "Anchura de las miniaturas (px)"

#: extension/stage-manager@wyliam/prefs.js:103
msgid "Minimum 96 px."
msgstr "Mínimo de 96 px."

#: extension/stage-manager@wyliam/prefs.js:104
msgid "Maximum items in the strip"
msgstr "Máximo de elementos en la barra lateral"

#: extension/stage-manager@wyliam/prefs.js:104
msgid "0 = as many as fit the screen height."
msgstr "0 = los que quepan en la altura de la pantalla."

#: extension/stage-manager@wyliam/prefs.js:107
msgid "Shortcuts"
msgstr "Atajos"

#: extension/stage-manager@wyliam/prefs.js:108
msgid "GTK format, for example &lt;Super&gt;&lt;Alt&gt;s. Leave empty to disable. Press Enter to apply."
msgstr ""
"Formato de GTK, por ejemplo &lt;Super&gt;&lt;Alt&gt;s. Déjalo vacío para desactivar. Pulsa Intro "
"para aplicar."

#: extension/stage-manager@wyliam/prefs.js:133
msgid "Exclusions"
msgstr "Exclusiones"

#: extension/stage-manager@wyliam/prefs.js:134
msgid ""
"Apps that Stage Manager ignores: they stay loose, outside the stage and the strip. Default: GNOME"
" Sushi (org.gnome.NautilusPreviewer)."
msgstr ""
"Aplicaciones que Organizador visual ignora: quedan sueltas, fuera del escenario y de la barra "
"lateral. Predeterminado: GNOME Sushi (org.gnome.NautilusPreviewer)."

#: extension/stage-manager@wyliam/prefs.js:140
msgid "Pick an open window…"
msgstr "Elegir una ventana abierta…"

#: extension/stage-manager@wyliam/prefs.js:141
msgid ""
"After clicking here, click the window to ignore (for apps in the strip, click its thumbnail). Esc"
" cancels."
msgstr ""
"Tras hacer clic aquí, haz clic en la ventana que se debe ignorar (para aplicaciones de la barra "
"lateral, haz clic en su miniatura). Esc cancela."

#: extension/stage-manager@wyliam/prefs.js:148
msgid "Add a class manually (WM_CLASS / app-id)"
msgstr "Añadir una clase manualmente (WM_CLASS / app-id)"

#: extension/stage-manager@wyliam/prefs.js:169
msgid "Manage this app again"
msgstr "Volver a gestionar esta aplicación"

#~ msgid "Hold Alt while resizing to resize from the center"
#~ msgstr "Mantener Alt al redimensionar para hacerlo desde el centro"

