#: extension/stage-manager@wyliam/lib/indicator.js:13 extension/stage-manager@wyliam/lib/manager.js:378
#: extension/stage-manager@wyliam/prefs.js:26
msgid "Stage Manager"
msgstr "Organizador Visual"

#: extension/stage-manager@wyliam/lib/manager.js:378
msgid "Could not identify the app of this window."
msgstr "Não foi possível identificar o aplicativo dessa janela."

#: extension/stage-manager@wyliam/lib/manager.js:384
#, python-format
msgid "Ignoring: %s"
msgstr "Ignorando: %s"

#: extension/stage-manager@wyliam/lib/manager.js:396
