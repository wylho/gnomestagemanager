msgstr[0] "%s (%d Fenster)"
msgstr[1] "%s (%d Fenster)"

#: extension/stage-manager@wyliam/lib/strip.js:124
msgid "Bring to the stage"
msgstr "Auf die Bühne holen"

#: extension/stage-manager@wyliam/lib/strip.js:126
msgid "Add to the stage group"
msgstr "Zur Gruppe auf der Bühne hinzufügen"

#: extension/stage-manager@wyliam/lib/strip.js:129
msgid "Bring only one window"
msgstr "Nur ein Fenster holen"

#: extension/stage-manager@wyliam/lib/strip.js:131
msgid "Untitled"
msgstr "Ohne Titel"

#: extension/stage-manager@wyliam/lib/strip.js:133
msgid "Split the windows in the strip"
msgstr "Fenster in der Seitenleiste trennen"

#: extension/stage-manager@wyliam/lib/strip.js:138
msgid "New window"
msgstr "Neues Fenster"

#: extension/stage-manager@wyliam/lib/strip.js:139
msgid "Close all windows"
msgstr "Alle Fenster schließen"

#: extension/stage-manager@wyliam/lib/strip.js:139
msgid "Close window"
msgstr "Fenster schließen"

#: extension/stage-manager@wyliam/lib/strip.js:141
msgid "Quit app"
msgstr "Anwendung beenden"

#: extension/stage-manager@wyliam/lib/strip.js:148
msgid "Move to monitor"
msgstr "Auf Monitor verschieben"

#: extension/stage-manager@wyliam/lib/strip.js:151
#, python-format
msgid "Monitor %d"
msgstr "Monitor %d"

#: extension/stage-manager@wyliam/lib/strip.js:156
msgid "Move to workspace"
msgstr "In Arbeitsfläche verschieben"

#: extension/stage-manager@wyliam/lib/strip.js:160
#, python-format
msgid "Workspace %d"
msgstr "Arbeitsfläche %d"

#: extension/stage-manager@wyliam/lib/strip.js:167
msgid "Autotiling for groups"
msgstr "Autotiling für Gruppen"

#: extension/stage-manager@wyliam/lib/strip.js:171
msgid "Rearrange the stage group"
msgstr "Gruppe auf der Bühne neu anordnen"

#: extension/stage-manager@wyliam/lib/strip.js:172
msgid "Back to the stage"
msgstr "Zurück zur Bühne"

#: extension/stage-manager@wyliam/lib/strip.js:172 extension/stage-manager@wyliam/prefs.js:17
msgid "Show the desktop"
msgstr "Schreibtisch anzeigen"

#: extension/stage-manager@wyliam/lib/strip.js:174
msgid "Ignore this app (do not manage)"
msgstr "Diese Anwendung ignorieren (nicht verwalten)"

#: extension/stage-manager@wyliam/lib/strip.js:175
msgid "Preferences…"
msgstr "Einstellungen…"

#: extension/stage-manager@wyliam/prefs.js:9
msgid "Turn Stage Manager on/off"
msgstr "Stage Manager ein-/ausschalten"

#: extension/stage-manager@wyliam/prefs.js:10
msgid "Turn group autotiling on/off"
msgstr "Autotiling der Gruppen ein-/ausschalten"

#: extension/stage-manager@wyliam/prefs.js:11
msgid "Ignore / manage again the focused window's app"
msgstr "Anwendung des fokussierten Fensters ignorieren / wieder verwalten"

#: extension/stage-manager@wyliam/prefs.js:12
msgid "Pick a window to ignore with the mouse"
msgstr "Ein zu ignorierendes Fenster mit der Maus auswählen"

#: extension/stage-manager@wyliam/prefs.js:13
msgid "Switch to the most recent set in the strip"
msgstr "Zur zuletzt verwendeten Gruppe der Seitenleiste wechseln"

#: extension/stage-manager@wyliam/prefs.js:14
msgid "Add the most recent set to the stage"
msgstr "Die zuletzt verwendete Gruppe zur Bühne hinzufügen"

#: extension/stage-manager@wyliam/prefs.js:15
msgid "Remove the focused window from the group"
msgstr "Das fokussierte Fenster aus der Gruppe entfernen"

#: extension/stage-manager@wyliam/prefs.js:16
msgid "Rearrange the group as a mosaic"
msgstr "Gruppe als Mosaik neu anordnen"

#: extension/stage-manager@wyliam/prefs.js:51
msgid "General"
msgstr "Allgemein"

#: extension/stage-manager@wyliam/prefs.js:53
msgid "Stage Manager on"
msgstr "Stage Manager eingeschaltet"

#: extension/stage-manager@wyliam/prefs.js:54
msgid "Show recent apps"
msgstr "Zuletzt verwendete Anwendungen anzeigen"

#: extension/stage-manager@wyliam/prefs.js:54
msgid "When off, the strip only appears when the pointer touches the screen edge."
msgstr ""
"Ist dies ausgeschaltet, erscheint die Seitenleiste nur, wenn der Zeiger den Bildschirmrand "
"berührt."

#: extension/stage-manager@wyliam/prefs.js:55
msgid "Windows of an app"
msgstr "Fenster einer Anwendung"

#: extension/stage-manager@wyliam/prefs.js:56
msgid ""
"One at a time: each new window gets its own stage. All at once: windows of the same app go to the"
" same stage."
msgstr ""
"Eines nach dem anderen: Jedes neue Fenster erhält eine eigene Bühne. Alle zusammen: Fenster "
"derselben Anwendung kommen auf dieselbe Bühne."

#: extension/stage-manager@wyliam/prefs.js:57
msgid "One at a time"
msgstr "Eines nach dem anderen"

#: extension/stage-manager@wyliam/prefs.js:57
msgid "All at once"
msgstr "Alle zusammen"

#: extension/stage-manager@wyliam/prefs.js:58
msgid "Center when entering the stage"
msgstr "Beim Betreten der Bühne zentrieren"

#: extension/stage-manager@wyliam/prefs.js:58
msgid "Super+Alt+R centers the window (or rearranges the group) whenever you want."
msgstr ""
"Mit Super+Alt+R zentrieren Sie das Fenster (oder ordnen die Gruppe neu an), wann immer Sie "
"möchten."

#: extension/stage-manager@wyliam/prefs.js:59
msgid "Always keep centered (outside autotiling)"
msgstr "Immer zentriert halten (außerhalb von Autotiling)"

#: extension/stage-manager@wyliam/prefs.js:59
msgid ""
"The window returns to the center as soon as you drop it or finish resizing it. Overrides "
"“remember position”."
msgstr ""
"Das Fenster kehrt in die Mitte zurück, sobald Sie es loslassen oder die Größenänderung beenden. "
"Hat Vorrang vor „Position merken“."

#: extension/stage-manager@wyliam/prefs.js:60
msgid "Resize from the center"
msgstr "Größe vom Zentrum aus ändern"

#: extension/stage-manager@wyliam/prefs.js:61
msgid "The window grows or shrinks on both sides at once, keeping its center. Not used with autotiling."
msgstr ""
"Das Fenster wächst oder schrumpft auf beiden Seiten gleichzeitig und behält seine Mitte. Gilt "
"nicht beim automatischen Kacheln."

#: extension/stage-manager@wyliam/prefs.js:62
msgid "Off"
msgstr "Aus"

#: extension/stage-manager@wyliam/prefs.js:62
msgid "While holding Alt"
msgstr "Solange Alt gedrückt ist"

#: extension/stage-manager@wyliam/prefs.js:62
msgid "Always (Alt gives the regular resize)"
msgstr "Immer (Alt gibt die normale Größenänderung)"

#: extension/stage-manager@wyliam/prefs.js:63
msgid "Remember the position of windows moved by hand"
msgstr "Position von manuell verschobenen Fenstern merken"

#: extension/stage-manager@wyliam/prefs.js:63
msgid "When off, the window always returns to the center when entering the stage."
msgstr "Ist dies ausgeschaltet, kehrt das Fenster beim Betreten der Bühne immer in die Mitte zurück."

#: extension/stage-manager@wyliam/prefs.js:64
msgid "Re-center after resizing"
msgstr "Nach Größenänderung neu zentrieren"

#: extension/stage-manager@wyliam/prefs.js:65
msgid "Clicking the wallpaper shows the desktop"
msgstr "Klick auf das Hintergrundbild zeigt den Schreibtisch"

#: extension/stage-manager@wyliam/prefs.js:66
msgid "Windows go to the strip; click again to bring them back."
msgstr "Die Fenster wandern in die Seitenleiste; ein erneuter Klick holt sie zurück."

#: extension/stage-manager@wyliam/prefs.js:69
msgid "Window groups"
msgstr "Fenstergruppen"

#: extension/stage-manager@wyliam/prefs.js:70
msgid ""
"Drag a thumbnail from the strip onto the stage, or use Shift+click, or the + button on the "
"thumbnail. To remove a window, drag it onto the strip."
msgstr ""
"Ziehen Sie ein Vorschaubild aus der Seitenleiste auf die Bühne, oder verwenden Sie Umschalt+Klick"
" oder die +-Schaltfläche am Vorschaubild. Zum Entfernen ziehen Sie das Fenster auf die "
"Seitenleiste."

#: extension/stage-manager@wyliam/prefs.js:73
msgid "Autotiling (like Pop Shell)"
msgstr "Autotiling (wie Pop Shell)"

#: extension/stage-manager@wyliam/prefs.js:74
msgid ""
"Windows on the stage fill the whole screen in a tree layout, leaving the app strip on the left. "
"Resizing moves the divider; dropping a window onto another swaps them. Replaces the mosaic."
msgstr ""
"Die Fenster auf der Bühne füllen den ganzen Bildschirm in einer Baumstruktur und lassen die "
"Anwendungsleiste links frei. Größenänderung verschiebt den Teiler; ein Fenster auf ein anderes zu"
" ziehen vertauscht beide. Ersetzt das Mosaik."

#: extension/stage-manager@wyliam/prefs.js:75
msgid "Strip always visible with autotiling"
msgstr "Seitenleiste bei Autotiling immer sichtbar"

#: extension/stage-manager@wyliam/prefs.js:76
msgid ""
"When off, the strip hides (it appears when the pointer touches the edge) and windows use the "
"whole screen."
msgstr ""
"Ist dies ausgeschaltet, blendet sich die Seitenleiste aus (sie erscheint, wenn der Zeiger den "
"Rand berührt) und die Fenster nutzen den ganzen Bildschirm."

#: extension/stage-manager@wyliam/prefs.js:77
msgid "Autotiling margin (px)"
msgstr "Außenabstand beim Autotiling (px)"

#: extension/stage-manager@wyliam/prefs.js:77
msgid "Distance between windows and the screen edge (and the strip)."
msgstr "Abstand zwischen den Fenstern und dem Bildschirmrand (und der Seitenleiste)."

#: extension/stage-manager@wyliam/prefs.js:78
msgid "Autotiling gap between windows (px)"
msgstr "Abstand zwischen Fenstern beim Autotiling (px)"

#: extension/stage-manager@wyliam/prefs.js:79
msgid "Group layout"
msgstr "Gruppenanordnung"

#: extension/stage-manager@wyliam/prefs.js:80
msgid ""
"Mosaic: rearranges when a window joins or leaves, is resized, or is dropped onto another. Free: "
"only arranges when the composition of the group changes."
msgstr ""
"Mosaik: ordnet sich neu an, wenn ein Fenster hinzukommt oder geht, die Größe geändert oder es auf"
" ein anderes gezogen wird. Frei: ordnet nur an, wenn sich die Zusammensetzung der Gruppe ändert."

#. TRANSLATORS: layout mode where the user arranges windows freely (no automatic rearranging)
#: extension/stage-manager@wyliam/prefs.js:82
msgid "Mosaic"
msgstr "Mosaik"

#: extension/stage-manager@wyliam/prefs.js:82
msgid "Free"
msgstr "Frei"

#: extension/stage-manager@wyliam/prefs.js:85
msgid "Picture-in-Picture"
msgstr "Bild-im-Bild"

#: extension/stage-manager@wyliam/prefs.js:86
msgid ""
"Picture-in-Picture from Firefox and Chrome stays in the stage group where it appears (and goes "
"away with it). Only its width takes part in tiling; the height follows the video aspect ratio. "
"Drag the PiP to another corner to move it."
msgstr ""
"Bild-im-Bild von Firefox und Chrome bleibt in der Bühnengruppe, in der es erscheint (und "
"verschwindet mit ihr). Nur seine Breite nimmt am Tiling teil; die Höhe folgt dem Seitenverhältnis"
" des Videos. Ziehen Sie das Fenster in eine andere Ecke, um es zu verschieben."

#: extension/stage-manager@wyliam/prefs.js:89
msgid "Treat Picture-in-Picture as an exception"
msgstr "Bild-im-Bild als Ausnahme behandeln"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "PiP corner"
msgstr "Ecke für Bild-im-Bild"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "Bottom right"
msgstr "Unten rechts"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "Bottom left"
msgstr "Unten links"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "Top right"
msgstr "Oben rechts"

#: extension/stage-manager@wyliam/prefs.js:90
msgid "Top left"
msgstr "Oben links"

#: extension/stage-manager@wyliam/prefs.js:91
#, python-format
msgid "Maximum PiP width (% of the area)"
msgstr "Maximale Breite von Bild-im-Bild (% der Fläche)"

#: extension/stage-manager@wyliam/prefs.js:92
msgid "PiP title patterns (comma-separated)"
msgstr "Titelmuster für Bild-im-Bild (durch Kommas getrennt)"

#. TRANSLATORS: the side column of app thumbnails (recent apps)
#: extension/stage-manager@wyliam/prefs.js:98
msgid "Strip"
msgstr "Seitenleiste"

#: extension/stage-manager@wyliam/prefs.js:101
msgid "Strip side"
msgstr "Seite der Seitenleiste"

#: extension/stage-manager@wyliam/prefs.js:101
msgid "Left"
msgstr "Links"

#: extension/stage-manager@wyliam/prefs.js:101
msgid "Right"
msgstr "Rechts"

#: extension/stage-manager@wyliam/prefs.js:102
msgid "Show the + button on thumbnails"
msgstr "Schaltfläche + auf den Vorschaubildern anzeigen"

#: extension/stage-manager@wyliam/prefs.js:102
msgid "Adds the set to the stage group. Shift+click and dragging also work."
msgstr ""
"Fügt den Eintrag zur Gruppe auf der Bühne hinzu. Umschalt+Klick und Ziehen funktionieren "
"ebenfalls."

#: extension/stage-manager@wyliam/prefs.js:103
msgid "Show a close button on thumbnails"
msgstr "Schließen-Schaltfläche auf Miniaturen anzeigen"

#: extension/stage-manager@wyliam/prefs.js:103
msgid "Closes the window (all windows of a group). Middle-clicking a thumbnail always closes it."
msgstr "Schließt das Fenster (alle Fenster einer Gruppe). Ein Mittelklick auf eine Miniatur schließt sie immer."

#: extension/stage-manager@wyliam/prefs.js:104
msgid "Thumbnail width (px)"
msgstr "Breite der Vorschaubilder (px)"

#: extension/stage-manager@wyliam/prefs.js:104
msgid "Minimum 96 px."
msgstr "Mindestens 96 px."

#: extension/stage-manager@wyliam/prefs.js:105
msgid "Maximum items in the strip"
msgstr "Maximale Anzahl an Einträgen in der Seitenleiste"

#: extension/stage-manager@wyliam/prefs.js:105
msgid "0 = as many as fit the screen height."
msgstr "0 = so viele, wie in die Bildschirmhöhe passen."

#: extension/stage-manager@wyliam/prefs.js:108
msgid "Shortcuts"
msgstr "Tastenkürzel"

#: extension/stage-manager@wyliam/prefs.js:109
msgid "GTK format, for example &lt;Super&gt;&lt;Alt&gt;s. Leave empty to disable. Press Enter to apply."
msgstr ""
"GTK-Format, zum Beispiel &lt;Super&gt;&lt;Alt&gt;s. Leer lassen zum Deaktivieren. Zum Übernehmen "
"die Eingabetaste drücken."

#: extension/stage-manager@wyliam/prefs.js:134
msgid "Exclusions"
msgstr "Ausnahmen"

#: extension/stage-manager@wyliam/prefs.js:135
msgid ""
"Apps that Stage Manager ignores: they stay loose, outside the stage and the strip. Default: GNOME"
" Sushi (org.gnome.NautilusPreviewer)."
msgstr ""
"Anwendungen, die Stage Manager ignoriert: Sie bleiben frei, außerhalb der Bühne und der "
"Seitenleiste. Standard: GNOME Sushi (org.gnome.NautilusPreviewer)."

#: extension/stage-manager@wyliam/prefs.js:141
msgid "Pick an open window…"
msgstr "Ein geöffnetes Fenster auswählen …"

#: extension/stage-manager@wyliam/prefs.js:142
msgid ""
"After clicking here, click the window to ignore (for apps in the strip, click its thumbnail). Esc"
" cancels."
msgstr ""
"Klicken Sie nach dem Klick hier auf das zu ignorierende Fenster (bei Anwendungen in der "
"Seitenleiste auf deren Vorschaubild). Esc bricht ab."

#: extension/stage-manager@wyliam/prefs.js:149
msgid "Add a class manually (WM_CLASS / app-id)"
msgstr "Eine Klasse manuell hinzufügen (WM_CLASS / app-id)"

#: extension/stage-manager@wyliam/prefs.js:170
msgid "Manage this app again"
msgstr "Diese Anwendung wieder verwalten"

#~ msgid "Hold Alt while resizing to resize from the center"
#~ msgstr "Alt beim Ändern der Größe gedrückt halten, um vom Zentrum aus zu skalieren"

